{
  "name": "@sitehie/render-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright-backed RenderAdapter for sitehie carousel. Depends only on core/domain types and resolved styles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
