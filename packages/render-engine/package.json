    "test": "npm run build && node run-tests.mjs"
  },
  "dependencies": {
    "@sitehie/core": "*",
    "archiver": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.0",
    "typescript": "^5.7.0"
  }
}
