{
  "name": "sitehie-carousel-tool",
  "version": "1.0.0",
  "description": "CLI tool to generate Instagram carousel slides for sitehie Arabic tech education brand",
  "type": "module",
  "main": "engine.js",
  "exports": {
    ".": "./engine.js",
    "./engine": "./engine.js",
    "./render": "./render.js"
  },
  "bin": {
    "carousel": "./render.js"
  },
  "scripts": {
    "render": "node render.js",
    "list-themes": "node render.js --list-themes",
    "check-themes": "node scripts/check-themes.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "archiver": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.0",
    "prismjs": "^1.30.0"
  }
}
